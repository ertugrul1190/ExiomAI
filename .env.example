# XEQM-Hub environment template.
# Copy to .env (gitignored) and fill in. Never commit real values.
# Production: set these as platform secrets, not a file.

# Required: OpenAI API key (starts with sk-). Use a project key
# with a monthly budget limit set in the OpenAI dashboard.
OPENAI_API_KEY=

# Optional: enables GET /api/usage. At least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# EXIOM_USAGE_TOKEN=

# Number of proxies in front of the app (0 = none, 1 = one load balancer).
# Forwarded headers are only trusted from private/loopback peers unless:
# EXIOM_TRUST_PUBLIC_PROXY=1
# EXIOM_TRUSTED_PROXY_HOPS=1

# Paid-AI usage limits, per client unless stated (defaults shown)
# EXIOM_REQUESTS_PER_MINUTE=15
# EXIOM_REQUESTS_PER_DAY=300
# EXIOM_CLIENT_TOKENS_PER_DAY=400000
# EXIOM_GLOBAL_TOKENS_PER_DAY=20000000
# EXIOM_MAX_TRACKED_CLIENTS=50000

# Abuse protection (Task 12, defaults shown)
# EXIOM_FLOOD_REQUESTS_PER_MINUTE=120
# EXIOM_MAX_CONCURRENT_ANSWERS=4
# EXIOM_MAX_REQUEST_BYTES=262144

# Reasoning effort levers (defaults shown)
# EXIOM_ROUTER_REASONING_EFFORT=minimal
# EXIOM_MAIN_REASONING_EFFORT=low
# EXIOM_OFF_TOPIC_REASONING_EFFORT=minimal

# Local development only. Never in production: the debugger runs code.
# FLASK_DEBUG=1
